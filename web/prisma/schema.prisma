generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -- Better Auth tables (managed by better-auth, included here for visibility) --

model User {
  id             String    @id
  name           String?
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  role           String    @default("user")

  // Referral program
  referralCode   String?   @unique
  referredById   String?
  referralCount  Int       @default(0)
  freeWeeksEarned Int      @default(0)

  // Onboarding
  onboardingSkipped Boolean  @default(false)

  sessions       Session[]
  accounts       Account[]
  agent          Agent?
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// -- AgentHub Domain Models --

model Agent {
  id                String      @id @default(cuid())
  userId            String      @unique
  name              String
  studentName       String
  bio               String
  containerName     String      @unique
  botUsername       String?
  botToken          String?
  litellmKey        String?
  status            AgentStatus @default(PENDING_APPROVAL)
  provisioningStep  String?
  apiKey            String?
  approvedAt        DateTime?
  approvedBy        String?
  containerRunning  Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRuns       ServiceRun[]
  chatMessages      ChatMessage[]
}

model ServiceRun {
  id            String      @id @default(cuid())
  agentId       String
  serviceType   ServiceType
  status        RunStatus   @default(PENDING)
  inputPayload  Json?
  outputPayload String?     @db.Text
  error         String?
  createdAt     DateTime    @default(now())
  completedAt   DateTime?

  agent         Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  agentId   String
  role      String   // "user" | "assistant" | "system"
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

enum AgentStatus {
  PENDING_APPROVAL
  PROVISIONING
  RUNNING
  STOPPED
  ERROR
}

enum ServiceType {
  INBOX_CALENDAR
  LAB_REPORT
  JOB_APPLICATION
  PAPER_INTERROGATOR
  LECTURE_SUMMARIZER
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}
