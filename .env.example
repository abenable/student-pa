# =============================================================================
# Student-PA Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in all required values.
# NEVER commit `.env` to version control — it contains secrets.
#
# Quick Start Checklist:
#   [ ] Database credentials set
#   [ ] BETTER_AUTH_SECRET generated (use: openssl rand -base64 32)
#   [ ] LiteLLM endpoint and admin key configured
#   [ ] Telegram signup bot token obtained from @BotFather
#   [ ] PROVISIONER_SECRET generated (long random string)
#   [ ] Agent image built and tag matches AGENT_IMAGE below
#   [ ] (Optional) Telegram API ID & Hash for automatic bot creation
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL is used by the web dashboard (Better Auth + Prisma).
# For local dev, Docker Compose can spin up a Postgres container.
# For production, use a managed Postgres instance.

DB_PASSWORD=change-me-to-a-strong-password
DB_NAME=agenthub
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@db:5432/${DB_NAME}

# ── Web / Auth ────────────────────────────────────────────────────────────────
# BETTER_AUTH_URL must be the public URL students use to reach the dashboard.
# BETTER_AUTH_SECRET should be a cryptographically random string.

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-random-string
WEB_PORT=3000

# ── SMTP (Optional) ───────────────────────────────────────────────────────────
# Used for transactional emails (password resets, notifications).
# Leave blank to disable email features.
# For Gmail, use an App Password instead of your regular password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=True
SMTP_USERNAME=
SMTP_SENDER_EMAIL=
SMTP_PASSWORD=

# ── Worker URL (internal) ─────────────────────────────────────────────────────
# The web service talks to the worker via this URL.
# In Docker Compose, this resolves automatically.

WORKER_URL=http://127.0.0.1:8000

# ── LiteLLM / Model Configuration ────────────────────────────────────────────
# LiteLLM is an OpenAI-compatible proxy that Student-PA uses for:
#   1. Routing requests to LLM providers (OpenAI, Anthropic, local models, etc.)
#   2. Generating per-student API keys with spend tracking & rate limits
#
# You can self-host LiteLLM or use any OpenAI-compatible endpoint.
# See docs/SETUP.md for detailed LiteLLM setup instructions.

# Admin key with permission to create/delete keys via /key/generate
LITELLM_ADMIN_KEY=sk-admin-your-litellm-master-key

# Default model alias. Must match a model_name in your LiteLLM config.
# Examples: gpt-4o, claude-sonnet-4, Mythos, llama3-70b
DEFAULT_MODEL=Mythos

# ── Signup Bot ────────────────────────────────────────────────────────────────
# This is the public-facing Telegram bot students use to register.
# Create it by messaging @BotFather and running /newbot.
# Example: 123456789:ABCdefGHIjklMNOpqrSTUvwxyz

SIGNUP_BOT_TOKEN=your-signup-bot-token-from-botfather

# ── Provisioner ───────────────────────────────────────────────────────────────
# PROVISIONER_SECRET is a shared secret the web dashboard uses to
# authenticate with the worker's REST API. Generate a long random string.

PROVISIONER_SECRET=change-me-to-a-random-string

# The Docker image tag used when spinning up per-student agent containers.
# You must build this image before running the platform.
#   cd agent && docker build -t student-pa-agent:latest .
AGENT_IMAGE=student-pa-agent:latest

# Host path where per-student agent directories are created.
# Each student gets a subdirectory with their data and config.
AGENTS_BASE_DIR=./agents

# ── Telethon (BotFather Automation) ───────────────────────────────────────────
# These are ONLY needed if you want the worker to automatically create
# Telegram bots for each student via BotFather.
# If you skip this, students must use a single shared bot (see Template Agent).
#
# 1. Get API_ID and API_HASH from https://my.telegram.org/apps
# 2. Run: cd worker && uv run python auth_telephon.py
# 3. Authenticate with your personal Telegram account (one-time)

TELEGRAM_API_ID=your-api-id
TELEGRAM_API_HASH=your-api-hash

# Your personal phone number (with country code) for Telethon auth.
TELEGRAM_PHONE=+123456789

# Session file path. For Docker, mount this into the worker container.
TELEGRAM_SESSION=./worker/sessions/botfather_session

# ── Template Agent (Single-student / Dev Mode) ───────────────────────────────
# These settings are used when running the agent service directly via
# docker-compose.yml for local development or single-user deployments.
# They bypass the multi-tenant signup flow entirely.

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=
