# ── LiteLLM / Model Configuration ────────────────────────────────────────────
# Admin key for the provisioner to create per-student keys via LiteLLM API
LITELLM_ADMIN_KEY=sk-admin-your-litellm-master-key
DEFAULT_MODEL=Mythos

# ── Signup Bot ────────────────────────────────────────────────────────────────
# Token for the public onboarding bot (get from @BotFather)
SIGNUP_BOT_TOKEN=your-signup-bot-token-from-botfather

# ── Provisioner ───────────────────────────────────────────────────────────────
# Shared secret between signup-bot and provisioner
PROVISIONER_SECRET=change-me-to-a-random-string

# Docker image used for each student agent container
AGENT_IMAGE=ghcr.io/abenable/student-pa:latest

# Host path where per-student agent directories are created
AGENTS_BASE_DIR=./agents

# ── Telethon (BotFather automation) ───────────────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org/apps
TELEGRAM_API_ID=your-api-id
TELEGRAM_API_HASH=your-api-hash
# Your personal phone number for Telethon user account auth (used once)
TELEGRAM_PHONE=+123456789
# Session file path (for local dev: ./, for docker: /data/)
TELEGRAM_SESSION=./botfather_session

# ── Template Agent (single-student / dev mode) ───────────────────────────────
# These are only used by the 'agent' service in docker-compose.yml
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=
